{
  "name": "footlove-desktop",
  "version": "1.0.0",
  "description": "Mac desktop app for CSL match schedule with React",
  "main": "main.js",
  "scripts": {
    "dev:web": "vite --strictPort --port 5173",
    "dev:desktop": "node scripts/check-electron.cjs && wait-on tcp:5173 && ELECTRON_START_URL=http://localhost:5173 electronmon .",
    "dev": "npm run dev:web",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:desktop\"",
    "build:web": "vite build",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.10.3",
    "electronmon": "^2.0.2",
    "vite": "^7.1.3",
    "wait-on": "^8.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
